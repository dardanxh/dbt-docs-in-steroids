# Copy to .env for local dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dbtsteroids

# Swagger / OpenAPI docs. On for local dev so you can browse /docs and so the UI
# can generate types from /openapi.json.
DOCS_ENABLED=true

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Default dbt project path used to prefill the "register project" form in dev.
# Point at a dbt project whose target/ has a fresh manifest.json + catalog.json.
DEFAULT_DBT_PROJECT_PATH=/path/to/your/dbt-project
